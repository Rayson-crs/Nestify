{
  "name": "@nestify/desktop",
  "version": "1.9.2",
  "private": true,
  "type": "module",
  "main": "./dist-electron/main.js",
  "scripts": {
    "sync:version": "node ../../scripts/sync-app-version.mjs",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "prepare:sharp": "node scripts/prepare-sharp.mjs",
    "start": "npm run sync:version && npm run prepare:ffmpeg && npm run build:worker && electron-vite dev",
    "dev": "npm run sync:version && npm run prepare:ffmpeg && npm run build:worker && electron-vite dev",
    "build:worker": "vite build --config electron.worker.vite.config.ts",
    "build": "npm run sync:version && npm run prepare:ffmpeg && npm run prepare:sharp && electron-vite build && npm run build:worker",
    "dist": "npm run build && electron-builder --win portable --x64",
    "dist:artifact": "npm run sync:version && npm run prepare:ffmpeg && npm run prepare:sharp && electron-builder --win portable --x64",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@nestify/core": "0.1.0",
    "@nestify/rules": "0.1.0",
    "@nestify/shared": "0.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^0.544.0",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "app.nestify.desktop",
    "productName": "Nestify",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "npmRebuild": false,
    "electronDist": "../../node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/nestify-icon.ico",
      "resources/nestify-icon.png",
      "resources/nestify-icon.svg",
      "resources/third-party-notices.md",
      "package.json",
      "!**/*.{map,flow}",
      "!**/node_modules/ffmpeg-static/**/*",
      "!**/node_modules/@ffprobe-installer/**/*",
      "!**/node_modules/@img/**/*",
      "!**/node_modules/sharp/**/*",
      "!**/node_modules/lucide-react/**/*",
      "!**/node_modules/drizzle-orm/**/*",
      "!**/node_modules/opencc-js/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/sharp",
        "to": "sharp"
      },
      {
        "from": "../../config",
        "to": "config"
      },
      {
        "from": "resources/ffmpeg",
        "to": "resources/ffmpeg"
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "nestify-icon.ico",
          "nestify-icon.png",
          "nestify-icon.svg",
          "third-party-notices.md"
        ]
      }
    ],
    "win": {
      "icon": "resources/nestify-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nestify-v${version}.exe"
    },
    "portable": {
      "artifactName": "Nestify-v${version}.exe"
    }
  }
}
